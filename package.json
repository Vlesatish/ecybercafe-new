{
  "name": "ecybercafe",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "npm --prefix backend run dev",
    "build": "npm --prefix frontend run build && npm --prefix backend run build",
