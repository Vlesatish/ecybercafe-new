  },
  "dependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/sortablejs": "^1.15.9",
    "canvas-confetti": "^1.9.4",
    "firebase": "^12.17.1",
    "firebase-admin": "^14.2.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "pdfjs-dist": "^6.3.289",
    "sortablejs": "^1.15.7"
  }
}
